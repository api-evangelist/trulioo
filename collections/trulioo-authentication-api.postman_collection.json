      }
    ]
  },
  "info": {
    "_postman_id": "397ef7bc-b635-4697-b325-22e2aefb289d",
    "name": "Trulioo Business Verification Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Know Your Business (KYB) API for verifying legal entities, retrieving business registration data, and downloading business reports. Supports searching businesses by name and registration number, verifying a business record, and pulling the underlying registry document.\n\n\nContact Support:\n Name: Trulioo Support\n Email: support@trulioo.com",
      "type": "text/plain"
    }
  }
